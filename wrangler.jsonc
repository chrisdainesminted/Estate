// Cloudflare serves the built site in dist/ and, for /api/*, the landlord
// tools' server in worker/: each landlord workspace is a Durable Object
// with its own SQLite database, created on first use (nothing to set up in
// the dashboard). "name" must match the project's name in the Cloudflare
// dashboard.
{
  "name": "bedrock",
  "compatibility_date": "2026-10-01",
  "main": "worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "WORKSPACE", "class_name": "Workspace" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Workspace"] }]
}
